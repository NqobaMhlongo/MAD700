<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F4F6F3">

    <!-- Header Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textColor="#1B3B2B"
        android:textSize="28sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPantryCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Your saved ingredients"
        android:textColor="#5A6E60"
        android:textSize="15sp"
        android:layout_marginBottom="12dp" />

    <!-- RecyclerView for Pantry Items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPantryItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnPantryAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="+ Add New Ingredient"
        android:backgroundTint="#1B3B2B"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnPantryBack"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Back to Home"
        android:textColor="#5A6E60"
        android:textSize="16sp"
        app:strokeColor="#C5D1C8"
        app:cornerRadius="12dp"
        android:layout_marginTop="8dp" />

</LinearLayout>