<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smart Pantry"
                android:textColor="#1B3B2B"
                android:textSize="30sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Manage your ingredients. Waste less food."
                android:textColor="#5A6E60"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Pantry Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pantry Overview"
                    android:textColor="#1B3B2B"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPantrySummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#E8F0EC"
                    android:padding="14dp"
                    android:text="Your ingredients will appear here."
                    android:textColor="#2D4A3E"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quick Actions Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnAddIngredient"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="+ Add Ingredient"
                android:textColor="#1B3B2B"
                android:textSize="16sp"
                app:strokeColor="#1B3B2B"
                app:cornerRadius="12dp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnViewPantry"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="View My Pantry"
                android:backgroundTint="#1B3B2B"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnSuggestedRecipes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Suggested Recipes"
                android:backgroundTint="#3E6B54"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnSettings"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Settings"
                android:textColor="#5A6E60"
                android:textSize="16sp"
                app:strokeColor="#C5D1C8"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>