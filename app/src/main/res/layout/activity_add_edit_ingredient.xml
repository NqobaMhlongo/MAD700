<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:textColor="#1B3B2B"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enter the ingredient details below."
            android:textColor="#5A6E60"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ingredient Name *"
                    android:textColor="#1B3B2B"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etIngredientName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="e.g. Tomatoes"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="12sp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quantity *"
                    android:textColor="#1B3B2B"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:contentDescription="Ingredient quantity"
                    android:hint="e.g. 5"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12sp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Unit *"
                    android:textColor="#1B3B2B"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etUnit"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="e.g. pieces, g, ml"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="12sp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Expiry Date (optional)"
                    android:textColor="#1B3B2B"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etExpiryDate"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="YYYY-MM-DD"
                    android:inputType="text"
                    android:paddingHorizontal="12sp"
                    android:singleLine="true" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Save/Cancel Buttons -->
        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:text="Save Ingredient"
            android:backgroundTint="#1B3B2B"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnCancelIngredient"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="Cancel"
            android:textColor="#5A6E60"
            android:textSize="16sp"
            app:strokeColor="#C5D1C8"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>