<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F6F3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suggested Recipes"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textColor="#1B3B2B"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipes you can make with your pantry items."
            android:textSize="15sp"
            android:textColor="#5A6E60"
            android:paddingBottom="20dp" />

        <TextView
            android:id="@+id/tvRecipeMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking your pantry..."
            android:textSize="15sp"
            android:textColor="#3E6B54"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <!-- Recipe Cards Container -->
        <LinearLayout
            android:id="@+id/recipeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBackToHome"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Back to Home"
            android:textColor="#5A6E60"
            android:textSize="16sp"
            app:strokeColor="#C5D1C8"
            app:cornerRadius="12dp"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</ScrollView>